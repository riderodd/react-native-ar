{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".nvmrc",
    ".yarnrc.yml"
  ],
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build:android": {
      "env": [
        "ANDROID_HOME"
      ],
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/src/**",
        "$TURBO_ROOT$/android",
        "!$TURBO_ROOT$/android/build",
        "package.json",
        "react-native.config.js",
        "android",
        "!android/.gradle",
        "!android/build",
        "!android/app/build"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": [
        "RCT_REMOVE_LEGACY_ARCH",
        "RCT_USE_RN_DEP",
        "RCT_USE_PREBUILT_RNCORE"
      ],
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/*.podspec",
        "$TURBO_ROOT$/src/**",
        "$TURBO_ROOT$/ios",
        "package.json",
        "react-native.config.js",
        "ios",
        "!ios/build",
        "!ios/Pods"
      ],
      "outputs": []
    }
  }
}
